                                }

                            }

                        }

                        'PSCustomObject'
                        {

                            if ($_NetToRemove.category -eq $ResourceCategoryEnum.EthernetNetwork)
                            {

                                "[{0}] Network [$r] is a type [PsCustomObject]" -f $MyInvocation.InvocationName.ToString().ToUpper() | Write-Verbose
