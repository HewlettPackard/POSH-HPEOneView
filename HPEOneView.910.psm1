                $ErrorRecord = New-ErrorRecord HPEOneView.InputObjectResourceException InvalidResourceObject InvalidArgument "InputObject" -TargetType $InputObject.GetType().Name -Message $ExceptionMessage
                $PSCmdlet.ThrowTerminatingError($ErrorRecord)

            }

        }

        if ($_Uri)
        {

            Try
            {

                $_resp = Send-OVRequest -Uri $_Uri -Method POST -Body $_DataCollection -Hostname $ApplianceConnection

            }

            Catch
            {

                $PSCmdlet.ThrowTerminatingError($_)

