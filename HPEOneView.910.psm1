{

    static [hashtable] $DeprecatedCmdlets = @{
        VMA = @(
            "Add-OVEnclosure",
            "Disable-OVLogicalInterconnectPortMonitoring",
            "Enable-OVLogicalInterconnectPortMonitoring",
