                        $_Params.Password = $Credential.Password

                    }

                    elseif ($PSBoundParameters['Username'])
                    {

                        "[{0}] Providing user crednetials for directory auth." -f $MyInvocation.InvocationName.ToString().ToUpper() | Write-Verbose

