                    Try
                    {

                        $_ServerReport = Get-ServerFirmware -Server $_resource -Baseline $Baseline -InstallationPolicy $InstallationPolicy -ProgressID 1

                        $_ServerReport | ForEach-Object {

                            [void]$_FirmwareReportCollection.Add($_)

