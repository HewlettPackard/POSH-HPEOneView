            }

        }

        if ($PSBoundParameters['AddNetwork'])
        {

            $a = 1

            ForEach ($_NetToAdd in $AddNetwork)
            {

                switch ($_NetToAdd.GetType().Name)
                {

                    'String'
                    {

                        if ($_NetToAdd.startswith($EthernetNetworksUri))
