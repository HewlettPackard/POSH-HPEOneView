Function JoinObject
{

    [CmdletBinding ()]
    Param
    (

        [Parameter (Mandatory)]
        [ValidateNotNullOrEmpty()]
        [PSCustomObject]$Object1,

        [Parameter (Mandatory)]
        [ValidateNotNullOrEmpty()]
        [PSCustomObject]$Object2

    )

    $arguments = [PSCustomObject]@{}

    foreach ( $Property in $Object1.psobject.Properties){
        $arguments | Add-Member -NotePropertyName $Property.Name -NotePropertyValue $Property.value

    }

    foreach ( $Property in $Object2.psobject.Properties){
        $arguments | Add-Member -NotePropertyName $Property.Name -NotePropertyValue $Property.value

    }

    return [PSCustomObject]$arguments

}


