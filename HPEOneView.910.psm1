        [HPEOneView.Storage.StoragePool]$SnapshotStoragePool,

        [Parameter (Mandatory = $False, ParameterSetName = "ServerProfileObjectEphmeralVol")]
        [ValidateNotNullOrEmpty()]
        [object]$StorageSystem,

        [Parameter (Mandatory = $False, ParameterSetName = "ServerProfileObjectEphmeralVol")]
