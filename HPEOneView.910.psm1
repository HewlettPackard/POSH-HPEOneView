            if (([RegEx]::Match($InputObject.category, "id-pool-", $RegExInsensitiveFlag).Success -or $ResourceCategoryEnum.IPv4Subnet, $ResourceCategoryEnum.IPv6Subnet -contains $InputObject.category) -and $InputObject.ApplianceConnection)
