                        $PSCmdlet.ThrowTerminatingError($ErrorRecord)

                    }

                }

                $i++

            }

        }

        # Need to validate that the -Large switch parameter was passed.
        if ($PSBoundParameters.Keys.GetEnumerator() | ? { $_ -eq 'Large' })
        {

            if ($Large.IsPresent)
            {

                "[{0}] Setting NetworkSetType to 'Large'." -f $MyInvocation.InvocationName.ToString().ToUpper() | Write-Verbose

