                    }

                    Catch
                    {

                        $PSCmdlet.ThrowTerminatingError($_)

                    }

                    $_rangeObject | ForEach-Object { $_.PSObject.TypeNames.Insert(0,"HPEOneview.Appliance.AddressPoolRange") }

                    $_rangeObject

                }

            }

            elseif ([RegEx]::Match($InputObject.category, "id-pool-", $RegExInsensitiveFlag).Success -and -not($InputObject.ApplianceConnection))
