                    }

                    "[{0}] Adding network set '{1}' to Uplink Set" -f $MyInvocation.InvocationName.ToString().ToUpper(), $_NetSetToAdd.name | Write-Verbose

                    [void]$_UpdatedNetworkSetUris.Add($_NetSetToAdd.uri)

