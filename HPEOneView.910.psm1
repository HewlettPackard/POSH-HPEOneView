        {

            "[{0}] Processing Appliance Connection {1}" -f $MyInvocation.InvocationName.ToString().ToUpper(), $_appliance.Name | Write-Verbose

            $uri = '{0}?sort=name:asc' -f $ServerHardwareTypesUri

            if ($PSBoundParameters['Name'])
            {

