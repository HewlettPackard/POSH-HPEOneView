            Catch
            {

                $PSCmdlet.ThrowTerminatingError($_)

            }

            Try
            {

                "[{0}] Installing appliance CA signed certificate" -f $MyInvocation.InvocationName.ToString().ToUpper() | Write-Verbose

                $_resp = Send-OVRequest -Uri $applianceCsr -Method PUT -Body $_CertificateObject -HostName $ApplianceConnection

            }

            Catch
            {

                $PSCmdlet.ThrowTerminatingError($_)

            }

        }

        if ($PSBoundParameters['Async'])
        {

            $_resp

        }

        else
        {

            $_resp | Wait-OVTaskComplete

        }

    }

    End
    {

        '[{0}] Done.' -f $MyInvocation.InvocationName.ToString().ToUpper() | Write-Verbose

    }

