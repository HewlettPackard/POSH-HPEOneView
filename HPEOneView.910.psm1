                            Try
                            {

                                $_networkObject = Get-OVNetwork $_net -type Ethernet -appliance $ApplianceConnection

                                [void]$_UpdatedNetSet.networkUris.Add($_networkObject.uri)

                            }

                            Catch
                            {

                                $PSCmdlet.ThrowTerminatingError($_)

                            }

                        }

                    }

                    'PSCustomObject'
                    {

                        if ($_net.category -eq $ResourceCategoryEnum.EthernetNetwork)
