                $ErrorRecord = New-ErrorRecord HPEOneView.Cluster.ClusterResourceException ClusterResourceNotFound ObjectNotFound "Name" -Message $ExceptionMessage

                $PSCmdlet.WriteError($ErrorRecord)

            }

            else
            {

                ForEach ($_member in $_resp.members)
                {

                    $_member.PSObject.TypeNames.Insert(0,'HPEOneView.Cluster.HypervisorCluster')

                    $_member

                }

            }

        }

    }

}

