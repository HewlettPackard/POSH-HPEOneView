        [Parameter (Mandatory = $false, ParameterSetName = 'RemoteSupport')]
        [ValidateNotNullOrEmpty()]
        [String]$Currency = 'USD',

        [Parameter (Mandatory = $false, ParameterSetName = 'Default')]
        [Parameter (Mandatory = $false, ParameterSetName = 'RemoteSupport')]
        [ValidateNotNullOrEmpty()]
        [Float]$PowerCosts,

        [Parameter (Mandatory = $false, ParameterSetName = 'Default')]
