                                $ErrorRecord = New-ErrorRecord HPEOneView.NetworkResourceException InvalidArgumentValue InvalidArgument 'AddNetworkSet' -TargetType $_NetSetToAdd.GetType().Name -Message $ExceptionMessage
                                $PSCmdlet.ThrowTerminatingError($ErrorRecord)

