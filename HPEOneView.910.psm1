                    $PSCmdlet.ThrowTerminatingError($ErrorRecord)

                }

                Catch
                {

                    $PSCmdlet.ThrowTerminatingError($_)

                }

            }

        }

    }

    Process
    {

        if (($ConnectedSessions | Where-Object Name -eq $InputObject.ApplianceConnection.Name).ApplianceType -ne 'Composer')
