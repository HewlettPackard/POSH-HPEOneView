                    $_PatchOperation.op    = 'replace'
                    $_PatchOperation.path  = '/countryCode'
                    $_PatchOperation.value = $Country

                    [void]$_DataCenterAddressPatchOp.Add($_PatchOperation)

                }

                'TimeZone'
                {

                    $_PatchOperation = NewObject -PatchOperation
                    $_PatchOperation.op    = 'replace'
                    $_PatchOperation.path  = '/timeZone'
                    $_PatchOperation.value = $TimeZone

                    [void]$_DataCenterAddressPatchOp.Add($_PatchOperation)

                }

                'PrimaryContact'
                {

                    if ($PrimaryContact.Type -ne 'Contact')
                    {

                        $ErrorRecord = New-ErrorRecord HPEOneview.Appliance.RemoteSupportContactException InvalidArgumentValue InvalidArgument "PrimaryContact" -TargetType PSObject -Message "The PrimaryContact object resource provided is not a Remote Support Contact.  Please use the Get-OVRemoteSupportContact Cmdlet to get a valid contact object."
