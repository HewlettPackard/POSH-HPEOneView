        [Array]$ValidationOids = @(@{"1.3.6.1.4.1.311.20.2.2" = "Smart Card Logon"; "1.3.6.1.5.5.7.3.2" = "Client Authentication"}),

        [Parameter (Mandatory = $false, ParameterSetName = "Default")]
